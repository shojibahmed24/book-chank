  "type": "mcq",
  "set_id": "model-test-mcq-ch5",
  "question_text": "মাসুদের ভূমিকা কোন মনীষীর অবদানের সাথে সাদৃশ্যপূণর্?",
  "question_number": 23,
  "stimulus": "আমিরাবাদের লোকজন ইদানিং ছোটখাটো মাসআলায় বিভক্ত হয়ে পড়ছে। জনাব মাসুদ আমিরাবাদের কৃতিসন্ত্মান এবং একজন ইসলামিক স্কলার। তিনি স্থানীয় ৫টি মাদরাসার ৫ জন আলেমের সমন্বয়ে একটি কমিটি গঠন করেন। কোন মাসআলার উদ্ভব হলে কমিটি আলোচনা করে সবর্সম্মত সিদ্ধান্ত্ম দেয়। আমিরাবাদের জনপ্রতিনিধি জনাব সগীর তার পুত্রের বিরম্নদ্ধে একবস্ত্মা ত্রাণের চাল চুরির অভিযোগ প্রমাণিত হলে তিনি পুত্রকে পুলিশে সোপদর্ করেন।",
  "options": {
   "ক": "ইমাম বুখারি (রহ.)",
   "খ": "ইমাম গাযালি (রহ.)",
   "গ": "ইমাম আবু হানিফা (রহ.)",
   "ঘ": "ইবনে জারির আত তাবারি (রহ.)"
  },
