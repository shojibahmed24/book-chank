  "type": "saq",
  "set_id": null,
  "question_text": "'লীগ অব নেশনস' কেন গঠন করা হয়?",
  "question_number": 1,
  "stimulus": null,
  "options": null,
  "answer_key": null,
  "answer_pointer": null,
  "guide_solution": "যুদ্ধের কারণে মানবজাতির অবণর্নীয় দুভোর্গ এবং অশান্ত্মি সৃষ্টি হয়। এছাড়া সাধিত হয় ভয়ঙ্কর ধ্বংসলীলা। প্রথম\nবিশ্বযুদ্ধের ব্যাপকতা এবং ধ্বংসলীলা মানুষকে যুদ্ধের প্রতি বীতশ্রদ্ধ এবং শান্ত্মির জন্য আগ্রহী করে তোলে। এজন্যই বিশ্বশান্ত্মি\nপ্রতিষ্ঠার লÿ্যে গঠন করা হয় আন্ত্মজাির্তক প্রতিষ্ঠান 'লীগ অব নেশনস'।",
  "explanation": null,
