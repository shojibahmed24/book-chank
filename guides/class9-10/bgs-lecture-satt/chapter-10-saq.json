  "section": "lecture-saq",
  "type": "saq",
  "set_id": null,
  "question_text": "উৎপাদন বলতে কী বোঝায়?",
  "question_number": 19,
  "stimulus": null,
  "options": null,
  "answer_key": null,
  "answer_pointer": null,
  "guide_solution": "উৎপাদন হলো দ্রব্য বা সম্পদের এক অবস্থা থেকে অন্য অবস্থায় রূপান্ত্মর। উৎপাদনের জন্য ৪টি উপাদান আবশ্যক:\nভূমি, শ্রম, মূলধন, সংগঠন। যেমন—চেয়ারের জন্য কাঠ সংগ্রহ হয় ভূমি থেকে। কাঠ সংগ্রহের জন্য অথর্ এবং কাঠকে চেয়ারে\nরূপান্ত্মরের জন্য যন্ত্রপাতি ও অন্যান্য উপকরণ প্রয়োজন। এই অথর্ ও যন্ত্রপাতি মূলধন। এরপর প্রয়োজন শ্রমিক বা কারিগর,\nযিনি যন্ত্রপাতি ও নিজ শ্রমের সাহায্যে কাঠ থেকে চেয়ার প্রস্তুত করবেন। আর এই ভূমি, মূলধন ও শ্রমকে সমন্বিত করে চেয়ার\nউৎপাদন প্রক্রিয়া সম্পাদন করবেন সংগঠক বা উদ্যোক্তা।",
  "explanation": null,
  "marks": null,
