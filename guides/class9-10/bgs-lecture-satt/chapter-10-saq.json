  "type": "saq",
  "set_id": null,
  "question_text": "উপযোগ বলতে কী বোঝায়?",
  "question_number": 17,
  "stimulus": null,
  "options": null,
  "answer_key": null,
  "answer_pointer": null,
  "guide_solution": "উপযোগ একটি মানসিক ধারণা। সাধারণ কথায়, উপযোগ বলতে কোনো দ্রব্যের উপকারিতাকে বোঝায়। তবে\nঅর্থনীতিতে কোনো দ্রব্য বা সেবার মধ্যে মানুষের অভাব মেটানোর যে ÿমতা থাকে তাকে উপযোগ বলে। যেমন- ভাত খেলে\nমানুষের ক্ষুধা মেটে, গান শুনলে মন ভালো লাগে ইত্যাদি দ্রব্য বা সেবা মানুষের বিভিন্ন অভাব মেটায়।",
  "explanation": null,
  "marks": null,
